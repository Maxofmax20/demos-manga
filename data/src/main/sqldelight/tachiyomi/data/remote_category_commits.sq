-- KMK -->
CREATE TABLE remote_category_commits (
 command_id TEXT NOT NULL PRIMARY KEY,
 preview_id TEXT NOT NULL,
 before_json TEXT NOT NULL,
 after_json TEXT NOT NULL,
 committed_at INTEGER NOT NULL
);
-- KMK <--

findCommit:
SELECT * FROM remote_category_commits WHERE command_id = ?;

recordCommit:
INSERT INTO remote_category_commits(command_id,preview_id,before_json,after_json,committed_at) VALUES (?,?,?,?,?);
